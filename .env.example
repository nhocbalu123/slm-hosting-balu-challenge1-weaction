# App
APP_NAME=slm-hosting-balu-challenge1-weaction
ENVIRONMENT=local
LOG_LEVEL=INFO

# Auth: leave empty to disable API-key auth, or comma-separate keys.
API_KEYS=dev-balu-key
REQUESTS_PER_MINUTE=60

# Primary provider: vLLM OpenAI-compatible server
VLLM_BASE_URL=http://vllm-qwen:8000/v1
VLLM_API_KEY=EMPTY
VLLM_MODEL=qwen3.5-0.8b
PRIMARY_TIMEOUT_SECONDS=30

# Fallback provider: Ollama OpenAI-compatible server
ENABLE_FALLBACK=true
FALLBACK_BASE_URL=http://ollama:11434/v1
FALLBACK_API_KEY=ollama
FALLBACK_MODEL=qwen3.5:0.8b
FALLBACK_TIMEOUT_SECONDS=60

# Model download / vLLM serving
MODEL_ID=Qwen/Qwen3.5-0.8B
MODEL_LOCAL_DIR=./models/Qwen3.5-0.8B
VLLM_MODEL_PATH=/models/Qwen3.5-0.8B
PUBLIC_MODEL_NAME=qwen3.5-0.8b
VLLM_IMAGE=vllm/vllm-openai:v0.20.0-cu129-ubuntu2404
VLLM_DTYPE=half
MAX_MODEL_LEN=2048
MAX_NUM_SEQS=16
GPU_MEMORY_UTILIZATION=0.30

# Ollama
OLLAMA_MODEL=qwen3.5:0.8b
